<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="org.example.restaurantmanagement.mapper.OrderDetailMapper">


    <select id="listByOrderId"
            resultType="org.example.restaurantmanagement.entity.OrderDetail">


        SELECT

            id,

            order_id,

            dish_id,

            dish_name,

            dish_price,

            quantity,

            subtotal


        FROM order_detail


        WHERE order_id = #{orderId}



    </select>


</mapper>